# GitHub API 认证
GITHUB_TOKEN=ghp_xxxxxxxxxxxx
GITHUB_USER=your-username

# HuggingFace 认证
HF_TOKEN=hf_xxxxxxxxxxxx
HF_USER=your-username

# API 安全
API_KEY=your-secret-api-key
CORS_ORIGINS=*
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=120

# Webhook 签名验证
WEBHOOK_SECRET=your-webhook-secret

# 数据目录
DATA_DIR=./data
